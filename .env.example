# Required at query/ingest time. Do not commit a real key.
OPENAI_API_KEY=

# Optional. Leave empty to use https://api.openai.com/v1
# For a local OpenAI-compatible proxy, include the /v1 prefix when the server expects it.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_BASE_URL=

# Chat model used to write the answer.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used to build and search the index.
OPENAI_EMBED_MODEL=text-embedding-3-small

# Directories. Docker Compose overrides these to /app/data and /app/storage.
DATA_DIR=./data
STORAGE_DIR=./storage
