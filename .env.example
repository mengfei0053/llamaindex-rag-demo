# Required at query/ingest time. Do not commit a real key.
OPENAI_API_KEY=

# Optional. Leave empty to use https://api.openai.com/v1
# For a local OpenAI-compatible proxy, include the /v1 prefix when the server expects it.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_BASE_URL=

# Chat model used to write the answer.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used when EMBEDDING_PROVIDER=openai (the default).
OPENAI_EMBED_MODEL=text-embedding-3-small

# openai: call /v1/embeddings on OPENAI_BASE_URL (current behavior).
# local: ONNX embeddings via fastembed. Chat still uses OPENAI_* above.
# Use local when the proxy has chat but returns 404 for /v1/embeddings.
EMBEDDING_PROVIDER=openai

# Used only when EMBEDDING_PROVIDER=local. ~90MB Chinese ONNX model.
# LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# Where fastembed stores the ONNX file. First local start downloads it here.
# Docker Compose mounts ./fastembed-cache at /app/fastembed-cache.
# FASTEMBED_CACHE_PATH=./fastembed-cache

# Directories. Docker Compose overrides these to /app/data and /app/storage.
DATA_DIR=./data
STORAGE_DIR=./storage
